<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="Heater" Id="{fe81cd62-8fb3-4eb5-8579-8abf8e5327d3}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Heater
VAR_INPUT
	iWaterTemp : REAL;
END_VAR
VAR_OUTPUT
	oHeaterEnable : BOOL;
	oHeaterPower : REAL;
END_VAR
VAR_IN_OUT
	ioHeatStruct : THeater;
END_VAR
VAR
	pidParameters : ST_CTRL_PID_PARAMS;
	pidMode : E_CTRL_MODE;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[pidParameters.fKp := 10; //P
pidParameters.tTn := T#20S; //I - soustava ~1.45 C/s pri 100 %, ztraty ~0.4 C/s; rychlejsi I kmita
pidParameters.tTv := T#0S; //D vypnuto - cidlo teploty je zasumene
pidParameters.tCtrlCycleTime := T#200MS;
pidParameters.tTaskCycleTime := T#100MS;
pidParameters.fOutMaxLimit := 100;
pidParameters.fOutMinLimit := 0;
pidParameters.bDInTheFeedbackPath := FALSE;
pidParameters.bPInTheFeedbackPath := FALSE;
pidParameters.bARWOnIPartOnly := FALSE;
pidParameters.tTd := T#100MS;


{region "Manual/Automat"}
// switching state of engine - automatic or manual control (default state is manual)
IF ioHeatStruct.Cmd.AutCtrl THEN
    ioHeatStruct.State.AutCtrl := TRUE;
    ioHeatStruct.State.ManCtrl := FALSE;
END_IF;

IF ioHeatStruct.Cmd.ManCtrl THEN
    ioHeatStruct.State.ManCtrl := TRUE;
    ioHeatStruct.State.AutCtrl := FALSE;
END_IF;

ioHeatStruct.Cmd.AutCtrl := FALSE;
ioHeatStruct.Cmd.ManCtrl := FALSE;

IF NOT ioHeatStruct.State.AutCtrl AND NOT ioHeatStruct.State.ManCtrl THEN
    ioHeatStruct.State.ManCtrl := TRUE;
END_IF;
{endregion}


{region "ManCtrl"}
// processing manual actions - if command is processed, it is set to FALSE even if can't be processed
// Engine commands are turn off (stop) and turn on (start)
IF ioHeatStruct.State.ManCtrl THEN
    IF ioHeatStruct.Cmd.TurnOnMan AND NOT ioHeatStruct.State.GenErr THEN
        ioHeatStruct.State.EnableOut := TRUE;
    END_IF;

    IF ioHeatStruct.Cmd.TurnOffMan THEN
        ioHeatStruct.State.EnableOut := FALSE;
    END_IF;
END_IF;

ioHeatStruct.Cmd.TurnOnMan := FALSE;
ioHeatStruct.Cmd.TurnOffMan := FALSE;
{endregion}

{region "AutCtrl"}
//if request to run in automatic mode set outputs to right states if MAR
//AutoRequest shouldn't be reseted to false state
IF ioHeatStruct.State.AutCtrl THEN
    ioHeatStruct.State.EnableOut := ioHeatStruct.Cmd.Req2RunAutCtrl AND NOT ioHeatStruct.State.GenErr;
END_IF;
{endregion}

{region "Error states"}
// if water temperature is too high, stop heating and generate error
// (simulator destroys the tank above 99 C) - error is released after cooling down below 90 C
ioHeatStruct.ThresholdTimer(IN := iWaterTemp > 95.0, PT := T#1S);
IF ioHeatStruct.ThresholdTimer.Q THEN
    ioHeatStruct.State.Err := TRUE;
ELSIF iWaterTemp < 90.0 THEN
    ioHeatStruct.State.Err := FALSE;
END_IF;

ioHeatStruct.State.GenErr := ioHeatStruct.State.Err;

IF ioHeatStruct.State.GenErr THEN
    ioHeatStruct.State.EnableOut := FALSE;
END_IF;
{endregion}

{region "Power"}
// PID runs only in automatic mode while heating is enabled, otherwise it is held in reset (no integral wind-up)
IF ioHeatStruct.State.AutCtrl AND ioHeatStruct.State.EnableOut THEN
    pidMode := E_CTRL_MODE.eCTRL_MODE_ACTIVE;
ELSE
    pidMode := E_CTRL_MODE.eCTRL_MODE_RESET;
END_IF;

ioHeatStruct.PID(
	fSetpointValue := ioHeatStruct.ParamHeatingSetPointAutomat,
	fActualValue := iWaterTemp,
	fManSyncValue := 0,
	bSync := FALSE,
	eMode := pidMode,
	stParams := pidParameters);

IF NOT ioHeatStruct.State.EnableOut THEN
    ioHeatStruct.State.HeatingOut := 0;
ELSIF ioHeatStruct.State.ManCtrl THEN
    ioHeatStruct.State.HeatingOut := LIMIT(0.0, ioHeatStruct.ParamHeatingPowerManual, 100.0);
ELSE
    ioHeatStruct.State.HeatingOut := ioHeatStruct.PID.fOut;
END_IF;

ioHeatStruct.State.HeatingPower := ioHeatStruct.State.HeatingOut;

IF ioHeatStruct.State.GenErr THEN
    ioHeatStruct.State.StateInt := Global.Err;
ELSIF ioHeatStruct.State.EnableOut THEN
    ioHeatStruct.State.StateInt := Global.Running;
ELSE
    ioHeatStruct.State.StateInt := Global.Stop;
END_IF;
{endregion}


oHeaterPower := ioHeatStruct.State.HeatingOut;
oHeaterEnable := ioHeatStruct.State.EnableOut;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>